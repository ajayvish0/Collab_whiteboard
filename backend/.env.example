# Copy to .env (or set in your host's dashboard). All values are optional.
# Node 20+ can load it with: node --env-file=.env src/server.js

PORT=3000
# Comma-separated list of frontend origins allowed to connect.
CORS_ORIGINS=http://localhost:5173
# Postgres connection string. When unset, boards are kept in memory only.
# DATABASE_URL=postgres://user:password@host:5432/teamsketch
# Number of proxies in front of the app (1 on Render) so rate limits see real IPs.
TRUST_PROXY=0
LOG_LEVEL=info

# Limits
BOARD_TTL_DAYS=30
MAX_SHAPES_PER_BOARD=5000
MAX_USERS_PER_BOARD=50
MAX_MESSAGE_BYTES=262144
CREATE_BOARD_MAX=20
CREATE_BOARD_WINDOW_MS=600000
SOCKET_EVENT_BURST=200
SOCKET_EVENTS_PER_SEC=60
